---
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Rua da Passagem 149 — Botafogo',
  description = 'Apartamento de 3 quartos (2 suítes) em projeto autoral. 106 m² mobiliado, Rua da Passagem 149, Botafogo. A 3 min a pé da Arnaldo Quintela.',
  ogImage = 'og.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const baseUrl = import.meta.env.BASE_URL;

// GA4 Measurement ID — propriedade emaildocaio@gmail.com (Rua da Passagem 149)
// IDs do GA4 são públicos (aparecem no HTML servido), tudo bem hardcodar aqui.
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-0S8KEWFSWB';

// Identifica variante A/B baseado no path (/ = A, /v2/ = B)
const abVariant = Astro.url.pathname.includes('/v2') ? 'B' : 'A';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f5f3ee" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Rua da Passagem 149" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />

    <!-- Display font: Playfair Display (Google Fonts) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap"
    />

    <meta name="generator" content={Astro.generator} />

    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId, abVariant }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', gaId, {
            page_path: window.location.pathname,
            ab_variant: abVariant,
          });
        </script>
      </>
    )}
  </head>
  <body data-ab-variant={abVariant}>
    <slot />

    <script>
      import { initAll } from '../scripts/animations';
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAll);
      } else {
        initAll();
      }
    </script>

    <script is:inline>
      // GA4 — track click no WhatsApp (CTA principal) como conversão
      document.addEventListener('DOMContentLoaded', () => {
        const variant = document.body.dataset.abVariant || 'A';
        document.querySelectorAll('a[href*="wa.me"]').forEach((link) => {
          link.addEventListener('click', () => {
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'whatsapp_click', {
                event_category: 'conversao',
                event_label: 'whatsapp_cta',
                ab_variant: variant,
                page_path: window.location.pathname,
              });
            }
            console.log('[A/B] WhatsApp click — variant:', variant);
          });
        });
      });
    </script>
  </body>
</html>
