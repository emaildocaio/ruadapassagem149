---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionProjeto from '../components/SectionProjeto.astro';
import Marquee from '../components/Marquee.astro';
import SectionStats from '../components/SectionStats.astro';
import SectionGaleria from '../components/SectionGaleria.astro';
import SectionPorteiraFechada from '../components/SectionPorteiraFechada.astro';
import SectionEdificio from '../components/SectionEdificio.astro';
import SectionMapa from '../components/SectionMapa.astro';
import SectionPlanta from '../components/SectionPlanta.astro';
import SectionContato from '../components/SectionContato.astro';
---

<BaseLayout
  title="Rua da Passagem 149 — Apto de 3 quartos · Botafogo"
  description="Apartamento de 106 m² com 3 quartos (2 suítes) em projeto autoral de Rafael Ramos. Mobiliado, Rua da Passagem 149, Botafogo — a 10 min a pé da Arnaldo Quintela."
>
  <Hero />
  <SectionProjeto />
  <Marquee />
  <SectionStats />
  <SectionGaleria />
  <SectionPorteiraFechada />
  <SectionEdificio />
  <SectionMapa />
  <SectionPlanta />
  <SectionContato />
</BaseLayout>
