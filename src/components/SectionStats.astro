---
const stats = [
  { value: 106,  decimals: 0, suffix: 'm²',     label: 'Área privativa' },
  { value: 3,    decimals: 0, suffix: '',       label: 'Quartos (2 suítes)' },
  { value: 2,    decimals: 0, suffix: '+ lav.', label: 'Banheiros' },
  { value: 5,    decimals: 0, suffix: 'º',      label: 'Andar' },
  { value: 3,    decimals: 0, suffix: 'min',    label: 'a pé · Arnaldo Quintela' },
  { value: 2023, decimals: 0, suffix: '',       label: 'Ano da reforma' },
];
---

<section class="stats" aria-labelledby="stats-title">
  <div class="stats__inner">
    <header class="stats__header">
      <span class="stats__eyebrow" data-reveal="fade">
        <span class="stats__num">02</span>
        <span class="stats__divider"></span>
        <span>Em números</span>
      </span>

      <h2 id="stats-title" class="stats__title" data-reveal="text">
        A medida exata<br />da casa.
      </h2>
    </header>

    <ul class="stats__grid">
      {stats.map((stat) => (
        <li class="stats__card" data-reveal="fade">
          <span class="stats__value">
            <span data-counter={stat.value} data-counter-decimals={stat.decimals} data-counter-grouping="false">0</span>
            {stat.suffix && <span class="stats__suffix">{stat.suffix}</span>}
          </span>
          <span class="stats__label">{stat.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stats {
    background: var(--color-bone);
    color: var(--color-ink);
    padding: clamp(4rem, 9vh, 7rem) 0;
  }

  .stats__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 3rem);
  }

  .stats__header {
    margin-bottom: clamp(2.25rem, 5vh, 3.5rem);
  }

  .stats__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-stone);
    margin-bottom: 1.5rem;
  }

  .stats__num {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 1.5rem;
    color: var(--color-bronze);
    letter-spacing: 0;
  }

  .stats__divider {
    width: 40px;
    height: 1px;
    background: currentColor;
    opacity: 0.4;
  }

  .stats__title {
    font-size: clamp(2rem, 4.5vw, 3.75rem);
    line-height: 1.02;
    max-width: 16ch;
  }

  /* Bento 3×2 — preenche perfeito sem cells vazios */
  .stats__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.5rem, 0.8vw, 0.85rem);
  }

  @media (max-width: 720px) {
    .stats__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 420px) {
    .stats__grid {
      grid-template-columns: 1fr;
    }
  }

  .stats__card {
    background: var(--color-canvas);
    padding: clamp(1.4rem, 2.5vw, 2rem) clamp(1.15rem, 2vw, 1.6rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.85rem;
    min-height: clamp(8rem, 14vh, 10rem);
  }

  .stats__value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.8vw, 2.85rem);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .stats__suffix {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 0.5em;
    color: var(--color-stone);
    letter-spacing: 0;
  }

  .stats__label {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-stone);
    line-height: 1.3;
  }
</style>
