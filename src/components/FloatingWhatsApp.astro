---
const whatsappNumber = '5521965210442';
const whatsappMessage = encodeURIComponent(
  'Olá Caio! Vi o anúncio do apartamento na Rua da Passagem 149 e gostaria de agendar uma visita.'
);
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<a
  class="float-wa"
  href={whatsappLink}
  target="_blank"
  rel="noreferrer"
  aria-label="Falar pelo WhatsApp"
  data-float-wa
>
  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
  </svg>
</a>

<style>
  .float-wa {
    position: fixed;
    bottom: clamp(1.25rem, 3vw, 1.75rem);
    right: clamp(1.25rem, 3vw, 1.75rem);
    z-index: 60;
    width: 58px;
    height: 58px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #25D366;
    color: white;
    box-shadow:
      0 10px 28px rgba(37, 211, 102, 0.32),
      0 2px 8px rgba(0, 0, 0, 0.18);
    transition:
      transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.3s ease,
      opacity 0.4s ease;
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
    will-change: transform, opacity;
  }

  .float-wa.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .float-wa.is-hidden {
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
  }

  .float-wa:hover {
    transform: translateY(-4px) scale(1.05);
    box-shadow:
      0 14px 32px rgba(37, 211, 102, 0.42),
      0 4px 12px rgba(0, 0, 0, 0.22);
  }

  @media (max-width: 600px) {
    .float-wa {
      width: 52px;
      height: 52px;
    }
    .float-wa svg {
      width: 24px;
      height: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float-wa {
      transition: opacity 0.2s ease;
    }
    .float-wa.is-visible {
      transform: none;
    }
  }
</style>

<script>
  const fab = document.querySelector<HTMLAnchorElement>('[data-float-wa]');
  const contato = document.getElementById('contato');

  if (fab) {
    // Aparece após o usuário rolar 220px (~ saindo do hero).
    // Mantém o primeiro impacto editorial limpo, mas garante CTA sempre acessível ao engajar.
    const handleScroll = () => {
      const scrolled = window.scrollY > 220;
      fab.classList.toggle('is-visible', scrolled);
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // Esconde quando o usuário chega na seção Contato (CTA principal já visível).
    if (contato && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          fab.classList.toggle('is-hidden', entry.isIntersecting);
        },
        { rootMargin: '0px 0px -25% 0px', threshold: 0 }
      );
      observer.observe(contato);
    }
  }
</script>
